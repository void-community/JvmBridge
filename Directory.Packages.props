<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <JvmBridgeVersion Condition="'$(JvmBridgeVersion)' == ''">$(Version)</JvmBridgeVersion>
  </PropertyGroup>
  <ItemGroup>
    <GlobalPackageReference Include="NetAgents.Analyzers" Version="26.9.22.6016" />
    <PackageVersion Include="JvmBridge" Version="$(JvmBridgeVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="17.14.28" />
    <PackageVersion Include="Nito.AsyncEx.Context" Version="5.1.2" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
</Project>
