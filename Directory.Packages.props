<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Published sample baseline; CI supplies the freshly packed version explicitly. -->
    <JvmBridgeVersion Condition="'$(JvmBridgeVersion)' == ''">26.10.5.2586</JvmBridgeVersion>
  </PropertyGroup>
  <ItemGroup>
    <GlobalPackageReference Include="NetAgents.Analyzers" Version="26.10.16.1606" />
    <PackageVersion Include="JvmBridge" Version="$(JvmBridgeVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <!-- 18.10 requires .NET 11; build support and the Alpine test hosts target .NET 10. -->
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="18.11.0" />
    <PackageVersion Include="Nito.AsyncEx.Context" Version="5.1.2" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="System.CommandLine" Version="2.0.13" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
