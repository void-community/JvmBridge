<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- The samples and the tests use the package that this version was packed as, when artifacts/packages has it, as it has in CI. -->
    <JvmBridgeVersion Condition="'$(JvmBridgeVersion)' == '' and Exists('$(MSBuildThisFileDirectory)artifacts/packages/JvmBridge.$(Version).nupkg')">$(Version)</JvmBridgeVersion>
    <!-- Published sample baseline. -->
    <JvmBridgeVersion Condition="'$(JvmBridgeVersion)' == ''">26.10.5.2586</JvmBridgeVersion>
  </PropertyGroup>
  <ItemGroup>
    <GlobalPackageReference Include="NetAgents.Analyzers" Version="26.11.20.3876" />
    <PackageVersion Include="JvmBridge" Version="$(JvmBridgeVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <!-- 18.10 requires .NET 11; build support and the Alpine test hosts target .NET 10. -->
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="18.12.2" />
    <PackageVersion Include="Nito.AsyncEx.Context" Version="5.1.2" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="System.CommandLine" Version="2.0.15" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
