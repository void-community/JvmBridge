<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="JvmBridge.Tool" />
    <InternalsVisibleTo Include="JvmBridge.Tool.Tests" />
    <InternalsVisibleTo Include="JvmBridge.IntegrationTests" />
    <!-- Launcher.java is the source of Launcher.class; a test compiles it with Java 8 and fails when the two differ. -->
    <None Include="Launcher/Launcher.java" />
    <EmbeddedResource Include="Launcher/Launcher.class" LogicalName="Launcher.class" />
  </ItemGroup>
</Project>
