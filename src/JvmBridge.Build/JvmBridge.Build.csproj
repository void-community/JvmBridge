<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="JvmBridge.Build.Tests" />
    <InternalsVisibleTo Include="JvmBridge.Maintenance" />
    <InternalsVisibleTo Include="JvmBridge.IntegrationTests" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Nito.AsyncEx.Context" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <UsingTask TaskName="JvmBridge.Build.RepositoryTask" AssemblyFile="$(TargetPath)" />
  <Target Name="Generate" DependsOnTargets="Build">
    <RepositoryTask Operation="Generate" />
  </Target>
  <Target Name="VerifyGenerated" DependsOnTargets="Build">
    <RepositoryTask Operation="VerifyGenerated" />
  </Target>
  <Target Name="VerifyCoverage" DependsOnTargets="Build">
    <RepositoryTask Operation="VerifyCoverage" />
  </Target>
  <Target Name="CompileFixtures" DependsOnTargets="Build">
    <RepositoryTask Operation="CompileFixtures" />
  </Target>
</Project>
