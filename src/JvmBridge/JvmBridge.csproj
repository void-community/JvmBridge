<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>JvmBridge</PackageId>
    <Description>Generated JNI and JVMTI bindings, JVM runtime helpers, and NativeAOT agents for .NET.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- The JDK provisioning task is loaded by MSBuild from tasks/, not referenced as a library. -->
    <NoWarn>$(NoWarn);NU5100</NoWarn>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeAgentGenerator;IncludeProvisionTask;IncludeWindowsX86Compatibility</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../JvmBridge.Generator/JvmBridge.Generator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../JvmBridge.Tasks/JvmBridge.Tasks.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <InternalsVisibleTo Include="JvmBridge.Tests" />
    <InternalsVisibleTo Include="JvmBridge.Tool" />
    <None Include="buildTransitive/*" Pack="true" PackagePath="buildTransitive" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../NOTICE.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Target Name="IncludeAgentGenerator">
    <MSBuild Projects="../JvmBridge.Generator/JvmBridge.Generator.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework">
      <Output TaskParameter="TargetOutputs" ItemName="AgentGeneratorAssembly" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(AgentGeneratorAssembly)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>
  <Target Name="IncludeProvisionTask">
    <MSBuild Projects="../JvmBridge.Tasks/JvmBridge.Tasks.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework">
      <Output TaskParameter="TargetOutputs" ItemName="ProvisionTaskAssembly" />
    </MSBuild>
    <PropertyGroup>
      <ProvisionTaskDirectory>@(ProvisionTaskAssembly->'%(RootDir)%(Directory)')</ProvisionTaskDirectory>
    </PropertyGroup>
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(ProvisionTaskDirectory)JvmBridge.Tasks.dll;$(ProvisionTaskDirectory)JvmBridge.Launcher.dll;$(ProvisionTaskDirectory)Nito.*.dll" PackagePath="tasks" />
    </ItemGroup>
  </Target>
  <Import Project="Native/WindowsX86/Build.targets" />
</Project>
