<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <JvmBridgeHost>true</JvmBridgeHost>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <JvmBridgeAbiInspector>true</JvmBridgeAbiInspector>
    <!-- The .NET 11 SDK's Native AOT publish compiles without the full build, so the XML documentation file that the analyzers generate never reaches bin, and
         publishing it fails with MSB3030. Publish runs the full build, as before .NET 11. -->
    <UseOptimizedPublish>false</UseOptimizedPublish>
    <RestoreAdditionalProjectSources Condition="Exists('$(MSBuildThisFileDirectory)../../artifacts/packages')">$(MSBuildThisFileDirectory)../../artifacts/packages</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JvmBridge" />
  </ItemGroup>
</Project>
