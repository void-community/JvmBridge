<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <JvmBridgeHost>true</JvmBridgeHost>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <JvmBridgeAbiInspector>true</JvmBridgeAbiInspector>
    <!-- The analyzers generate an XML documentation file, which a native executable has no use for. The .NET 11 SDK's Native AOT publish compiles without the full build
         (UseOptimizedPublish), so the file never reaches bin, and publishing it would fail with MSB3030. -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <RestoreAdditionalProjectSources Condition="Exists('$(MSBuildThisFileDirectory)../../artifacts/packages')">$(MSBuildThisFileDirectory)../../artifacts/packages</RestoreAdditionalProjectSources>
    <!-- Each package-consumer run has its own version and native target. -->
    <NuGetLockFilePath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath.Replace('\', '/'))locks/$(JvmBridgeVersion)/$(TargetFramework)/$(RuntimeIdentifier)/packages.lock.json'))</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JvmBridge" />
  </ItemGroup>
</Project>
