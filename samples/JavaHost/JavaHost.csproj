<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <JvmBridgeHost>true</JvmBridgeHost>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <JvmBridgeAbiInspector>true</JvmBridgeAbiInspector>
    <RestoreAdditionalProjectSources>$(MSBuildThisFileDirectory)../../artifacts/packages</RestoreAdditionalProjectSources>
    <!-- Each package-consumer run has its own version and native target. -->
    <NuGetLockFilePath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath.Replace('\', '/'))locks/$(JvmBridgeVersion)/$(TargetFramework)/$(RuntimeIdentifier)/packages.lock.json'))</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JvmBridge" />
  </ItemGroup>
</Project>
