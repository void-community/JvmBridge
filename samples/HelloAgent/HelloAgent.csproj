<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <JvmBridgeAgent>true</JvmBridgeAgent>
    <PublishAot>true</PublishAot>
    <IsPackable>false</IsPackable>
    <RestoreAdditionalProjectSources Condition="Exists('$(MSBuildThisFileDirectory)../../artifacts/packages')">$(MSBuildThisFileDirectory)../../artifacts/packages</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JvmBridge" />
  </ItemGroup>
</Project>
