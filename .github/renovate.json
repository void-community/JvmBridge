{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "dependencyDashboard": {
    "enabled": true
  },
  "ignoreDeps": [
    "JvmBridge"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "customManagers": [
    {
      "customType": "regex",
      "description": "SDKs listed one per line under setup-dotnet's dotnet-version, which the github-actions manager reads only as a single value",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "\\n[ \\t]+(?<currentValue>\\d+\\.\\d+\\.\\d{3}(?:-[0-9A-Za-z.]+)?)\\b"
      ],
      "depNameTemplate": "dotnet-sdk",
      "datasourceTemplate": "dotnet-version"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "CI keeps a 10.0 SDK beside the 11.0 one, so neither moves to another major",
      "matchDepNames": [
        "dotnet-sdk"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}
