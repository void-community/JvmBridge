<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Keep dotnet test on the configured VSTest adapter and retain standalone xUnit execution. -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <ProjectReference Include="../../src/JvmBridge.Build/JvmBridge.Build.csproj" />
    <ProjectReference Include="../../src/JvmBridge.Launcher/JvmBridge.Launcher.csproj" />
    <!-- The JDK cache that JvmBridge.Testing and the build tasks share, so LegacyJavaTests unpacks each pinned JDK once per machine. -->
    <Compile Include="../../src/Shared/PinnedJdk.cs" Link="Shared/PinnedJdk.cs" />
  </ItemGroup>
</Project>
