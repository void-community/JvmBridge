<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Keep dotnet test on the configured VSTest adapter and retain standalone xUnit execution. -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <ProjectReference Include="../../src/JvmBridge.Build/JvmBridge.Build.csproj" />
    <ProjectReference Include="../../src/JvmBridge.Launcher/JvmBridge.Launcher.csproj" />
    <!-- The JDK cache that JvmBridge.Testing and the build tasks share, so LegacyJavaTests unpacks each pinned JDK once per machine. -->
    <Compile Include="../../src/Shared/PinnedJdk.cs" Link="Shared/PinnedJdk.cs" />
  </ItemGroup>
  <!--
    CI publishes the samples for every runtime and hands them to the tests in artifacts/publish-<runtime>. The tests look for the samples of their target where the README has a developer publish them, so those
    of the runtime that the tests run on go there.
  -->
  <Target Name="CopyPublishedSamples" AfterTargets="Build">
    <ItemGroup>
      <PublishedSample Include="HelloAgent" Destination="agent" />
      <PublishedSample Include="JavaHost" Destination="host" />
      <PublishedSample Include="FootprintAgent" Destination="footprint-agent" />
      <PublishedSampleFile Include="../../artifacts/publish-$(NETCoreSdkRuntimeIdentifier)/%(PublishedSample.Identity)/**" Destination="%(PublishedSample.Destination)" />
    </ItemGroup>
    <Copy SourceFiles="@(PublishedSampleFile)" DestinationFiles="@(PublishedSampleFile->'../../artifacts/%(Destination)/$(NETCoreSdkRuntimeIdentifier)/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
