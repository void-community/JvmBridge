<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Keep dotnet test on the configured VSTest adapter and retain standalone xUnit execution. -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <ProjectReference Include="../../src/JvmBridge.Tool/JvmBridge.Tool.csproj" />
    <ProjectReference Include="../../src/JvmBridge.Launcher/JvmBridge.Launcher.csproj" />
    <ProjectReference Include="../../src/JvmBridge.Testing/JvmBridge.Testing.csproj" />
    <!-- The class files and Java sources the tests read. -->
    <None Include="../JvmBridge.Tests/Fixtures/ClassFiles/**/*.class" Link="Fixtures/ClassFiles/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/JvmBridge.Launcher/Launcher/Launcher.java" Link="Launcher/Launcher.java" CopyToOutputDirectory="PreserveNewest" />
    <!-- The probe sits beside the launcher so that one javac run compiles both. -->
    <None Include="PlatformProbe.java" Link="Launcher/PlatformProbe.java" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
